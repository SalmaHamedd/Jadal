<!--
  Status-bar icon for push notifications.

  Android renders the small icon as a MASK: every non-transparent pixel is
  painted a flat colour and all colour information is discarded. A full-colour
  launcher icon used here shows up as a solid white square on Android 5+, which
  is why this is a dedicated single-colour silhouette rather than @mipmap/ic_launcher.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Speech bubble — the app's debate motif, and legible at 24dp. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M20,2H4C2.9,2 2,2.9 2,4v18l4,-4h14c1.1,0 2,-0.9 2,-2V4C22,2.9 21.1,2 20,2z" />
</vector>
